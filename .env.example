# Copy this file to .env. Values here are safe placeholders only.
SECRET_KEY=change-me-before-use
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_SETTINGS_MODULE=config.settings.development

# Production example: postgresql://mindrepo:password@localhost:5432/mindrepo
# Production-only values; leave blank for local development.
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
PWA_ENABLED=False
# Keep private offline storage off in production until browser/PWA validation is complete.
OFFLINE_KNOWLEDGE_ENABLED=False
LOG_LEVEL=INFO
# Production: a directory writable by the Gunicorn service for login throttling.
CACHE_LOCATION=/var/cache/mindrepo
